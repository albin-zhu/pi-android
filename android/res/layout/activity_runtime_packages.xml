<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="16dp">
 <EditText android:id="@+id/packageSearch" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:hint="搜索 kubectl、vim、jq、tmux…" android:importantForAutofill="no" android:inputType="text" android:maxLines="1"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <Button android:id="@+id/packageRefresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="刷新仓库"/>
  <Button android:id="@+id/packageInstalled" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="已安装"/>
  <ProgressBar android:id="@+id/packageProgress" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="12dp" android:visibility="gone"/>
 </LinearLayout>
 <TextView android:id="@+id/packageStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="加载仓库…" android:textSize="13sp"/>
 <ListView android:id="@+id/packageList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingTop="8dp"/>
</LinearLayout>
