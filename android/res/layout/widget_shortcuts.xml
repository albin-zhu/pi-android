<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_surface">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="橙橙 · 快捷入口" android:textStyle="bold" android:textSize="18sp" android:textColor="@color/widget_ink" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <Button android:id="@+id/widget_chat" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="聊天" />
  <Button android:id="@+id/widget_circle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="圈选" />
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <Button android:id="@+id/widget_voice" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="语音" />
  <Button android:id="@+id/widget_sessions" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="会话" />
 </LinearLayout>
</LinearLayout>
